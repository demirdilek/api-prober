{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Latency (99th Percentile)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(kube_prober_latency_seconds_bucket{le!=\"\"}[2m])) by (le, target))",
          "legendFormat": "{{target}} (p99)"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "s" }
      }
    },
    {
      "title": "Traffic (Probe Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(kube_prober_traffic_total[2m])) by (target)",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "cps" }
      }
    },
    {
      "title": "Errors (Failed Probes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kube_prober_errors_total[2m])) by (target, category) or vector(0)",
          "legendFormat": "{{target}} - Category {{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": { 
          "custom": { "drawStyle": "line" }, 
          "unit": "cps",
          "noValue": "0"
        }
      }
    },
    {
      "title": "Saturation (Active Workers)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "(sum(kube_prober_saturation_active_workers) / clamp_min(max(kube_prober_saturation_max_workers), 1)) * 100",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "percent" }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sre", "network"],
  "time": { "from": "now-15m", "to": "now" },
