<file path="helm/kube-prober/templates/prometheusrule.yaml">
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: "{{ .Release.Name }}-rules"
  labels:
    release: prom-stack
spec:
  groups:
    - name: kube-prober-golden-signals
      rules:
        # Latency: High p99 Latency
        - alert: HighLatency
          expr: |
            (
              histogram_quantile(0.99, sum(rate(kube_prober_latency_seconds_bucket{le!=""}[2m])) by (le, target)) > 1.5
            ) and (
              sum(rate(kube_prober_traffic_total[2m])) by (target) > 0.05
            ) 
          for: 1m
          labels:
            severity: warning
          annotations:
            summary: '{{`High p99 latency on target {{ $labels.target }}`}}'
            hint: "Check CPU/Memory utilization, database connections, or network policies on upstream target."

        # Traffic: Traffic Collapse / Total Outage
        - alert: TrafficCollapse
          expr: |
            (
              sum(rate(kube_prober_errors_total[2m])) by (target) == sum(rate(kube_prober_traffic_total[2m])) by (target)
            ) and (
              sum(rate(kube_prober_traffic_total[2m])) by (target) > 0
            )
          for: 1m
          labels:
            severity: critical
          annotations:
            summary: '{{`Traffic collapse / total outage on target {{ $labels.target }}`}}'
            hint: "Check if prober workers are failing to reach the endpoint or if the target service port is misconfigured."

        # Errors: High failure rate
        - alert: HighErrorRate
          expr: sum(increase(kube_prober_errors_total[2m])) by (target) > 0.01
          for: 1m
          labels:
            severity: critical
          annotations:
            summary: '{{`High error rate detected on target {{ $labels.target }}`}}'
            hint: "Target application is failing probes (4xx/5xx/timeout). Inspect pod logs via 'kubectl logs' or check service endpoints."

        # Saturation: Worker Capacity Reached
        - alert: MaxWorkersReached
          expr: |
            (
              sum(kube_prober_saturation_active_workers) / clamp_min(max(kube_prober_saturation_max_workers), 1)
            ) >= 0.9
          for: 1m
          labels:
            severity: warning
          annotations:
            summary: "Prober worker capacity saturated (>= 90% of max workers utilized)"
            hint: "Increase WORKERS environment variable or adjust PROBE_INTERVAL_SECONDS to reduce worker queue pressure."
        
        # Certificate Expiry Warning (Triggers if cert expires in under 30 days)
        - alert: TLSCertificateExpiringSoon
          expr: kube_prober_tls_cert_expiry_days < 30
          for: 1m
          labels:
            severity: warning
          annotations:
            summary: '{{`TLS Certificate expiring soon on target {{ $labels.target }}`}}'
            hint: "Renew the TLS/SSL certificate or check cert-manager secret renewal status."

        # TLS Handshake Failure (Triggers on handshake/CA trust errors)
        - alert: TLSHandshakeFailed
          expr: sum(rate(kube_prober_errors_total{category="tls_error"}[2m])) by (target) > 0
          for: 1m
          labels:
            severity: critical
          annotations:
            summary: '{{`TLS handshake failed on target {{ $labels.target }}`}}'
            hint: "Check TLS certificate validity, SAN domain coverage, or local CA trust store."

        # TCP Connection Refused / Layer 4 Failure
        - alert: TCPConnectionRefused
          expr: sum(rate(kube_prober_errors_total{category="connection_refused"}[2m])) by (target) > 0
          for: 1m
          labels:
            severity: critical
          annotations:
            summary: '{{`TCP connection refused on target {{ $labels.target }}`}}'
            hint: "Target pod might be down, crash-looping, or rejecting connections on specified port."

    - name: kube-prober-slo-recording-rules
      rules:
        # Availability: Error ratio (1 - success rate)
        - record: target:kube_prober_error_ratio:rate5m
          expr: |
            sum by (target) (rate(kube_prober_errors_total[5m])) 
            / 
            clamp_min(sum by (target) (rate(kube_prober_traffic_total[5m])), 0.001)

        - record: target:kube_prober_error_ratio:rate1h
          expr: |
            sum by (target) (rate(kube_prober_errors_total[1h])) 
            / 
            clamp_min(sum by (target) (rate(kube_prober_traffic_total[1h])), 0.001)

        # Latency: Ratio of requests slower than 500ms
        - record: target:kube_prober_latency_ratio:rate5m
          expr: |
            1 - (
              sum by (target) (rate(kube_prober_latency_seconds_bucket{le="0.5"}[5m])) 
              / 
              clamp_min(sum by (target) (rate(kube_prober_latency_seconds_count[5m])), 0.001)
            )

        - record: target:kube_prober_latency_ratio:rate1h
          expr: |
            1 - (
              sum by (target) (rate(kube_prober_latency_seconds_bucket{le="0.5"}[1h])) 
              / 
              clamp_min(sum by (target) (rate(kube_prober_latency_seconds_count[1h])), 0.001)
            )

    - name: kube-prober-slo-alerts
      rules:
        # SLO: 99.9% Availability (Error Budget: 0.001) -> 14.4x burn rate over 1h
        - alert: AvailabilityBurnRateHigh
          expr: |
            target:kube_prober_error_ratio:rate1h > (0.001 * 14.4)
            and
            target:kube_prober_error_ratio:rate5m > (0.001 * 14.4)
          labels:
            severity: critical
          annotations:
            summary: '{{`High availability error budget burn rate on {{ $labels.target }}`}}'
            hint: "Check upstream targets for hard failures."

        # SLO: 99% Latency < 500ms (Error Budget: 0.01) -> 14.4x burn rate over 1h
        - alert: LatencyBurnRateHigh
          expr: |
            target:kube_prober_latency_ratio:rate1h > (0.01 * 14.4)
            and
            target:kube_prober_latency_ratio:rate5m > (0.01 * 14.4)
          labels:
            severity: critical
          annotations:
            summary: '{{`High latency error budget burn rate on {{ $labels.target }}`}}'
            hint: "Target is slow. Check resource saturation."
</file>

<file path="pkg/prober/prober_test.go">
package prober

import (
	"context"
	"net"
	"testing"
)

func TestMapToCategory(t *testing.T) {
	tests := []struct {
		name       string
		err        error
		statusCode int
		expected   ErrorCategory
	}{
		{
			name:       "HTTP Error",
			err:        nil,
			statusCode: 500,
			expected:   CategoryHTTP,
		},
		{
			name:       "DNS Resolution Error",
			err:        &net.DNSError{},
			statusCode: 0,
			expected:   CategoryDNS,
		},
		{
			name:       "Timeout Error",
			err:        context.DeadlineExceeded,
			statusCode: 0,
			expected:   CategoryTimeout,
		},
		{
			name:       "Success Target",
			err:        nil,
			statusCode: 200,
			expected:   "",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := MapToCategory(tt.err, tt.statusCode)
			if got != tt.expected {
				t.Errorf("MapToCategory() = %v, want %v", got, tt.expected)
			}
		})
	}
}

func TestErrorCategory_Hint(t *testing.T) {
	if CategoryDNS.Hint() == "" {
		t.Errorf("expected non-empty hint for CategoryDNS")
	}
	if CategoryHTTP.Hint() == "" {
		t.Errorf("expected non-empty hint for CategoryHTTP")
	}
}
