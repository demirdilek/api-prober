func TestMapToCategory(t *testing.T) {
	tests := []struct {
		name       string
		err        error
		statusCode int
		expected   ErrorCategory
	}{
		{
			name:       "HTTP Error",
			err:        nil,
			statusCode: 500,
			expected:   CategoryHTTP,
		},
		{
			name:       "DNS Resolution Error",
			err:        &net.DNSError{},
			statusCode: 0,
			expected:   CategoryDNS,
		},
		{
			name:       "Timeout Error",
