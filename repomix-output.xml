# ==============================================================================
# Prometheus Stack Local Configuration (Google SRE Best Practices)
# Dynamic Multi-Target Support, Anti-Alert-Fatigue & Actionable Notifications
# ==============================================================================

alertmanager:
  enabled: true
  config:
    global:
      resolve_timeout: 5m

    # --------------------------------------------------------------------------
    # Routing Tree
    # --------------------------------------------------------------------------
    route:
      receiver: 'slack-notifications'
      # Bündelt Alerts nach Name, Severity und Kategorie gegen Alert-Storms
      group_by: ['alertname', 'severity', 'category']
      group_wait: 10s
      group_interval: 5m
      # Anti-Alert-Fatigue: Wiederholt unveränderte Dauer-Alerts erst nach 12h
      repeat_interval: 12h
      
      routes:
        # Silenced K8s noisy internal watchdog
        - matchers:
            - alertname = Watchdog
          receiver: 'null'

        # Critical Alerts: Parallel Push-Benachrichtigung an Mobilgeräte
        - matchers:
            - severity = critical
          receiver: 'pushover-notifications'
          continue: true

        # Alle Standard-Alerts landen im zentralen Slack-Channel
        - matchers:
            - severity =~ "info|warning|critical"
          receiver: 'slack-notifications'

    # --------------------------------------------------------------------------
    # Receivers Configuration
    # --------------------------------------------------------------------------
    receivers:
      - name: 'null'

      # ------------------------------------------------------------------------
      # Slack Receiver
      # ------------------------------------------------------------------------
      - name: 'slack-notifications'
        slack_configs:
          - api_url: $SLACK_WEBHOOK_URL
            send_resolved: true
            title: '{{ if eq .Status "firing" }}:warning: [{{ .CommonLabels.severity | toUpper }}]{{ else }}:white_check_mark: [RESOLVED]{{ end }} {{ .CommonLabels.alertname }}'
            text: >-
              <!here>
              {{ range .Alerts }}
              *Time:* {{ .StartsAt.Format "15:04:05 MST" }}
              {{ if .Annotations.summary }}*Summary:* {{ .Annotations.summary }}{{ end }}
              {{ if $.CommonLabels.category }}*Category:* `{{ $.CommonLabels.category }}`{{ end }}
              {{ if .Annotations.description }}*Description:* {{ .Annotations.description }}{{ end }}
              {{ if .Annotations.hint }}
              *Actionable Diagnostic Hint:*
              > {{ .Annotations.hint }}
              {{ end }}
              ---
              {{ end }}

      # ------------------------------------------------------------------------
      # Pushover Receiver
      # ------------------------------------------------------------------------
      - name: 'pushover-notifications'
        pushover_configs:
          - user_key: $PUSHOVER_USER_KEY
            token: $PUSHOVER_API_TOKEN
            priority: '1' # Umgeht Stummschaltung bei kritischen Systemausfällen
            sound: 'alien'
            send_resolved: true
            title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} ({{ if .CommonLabels.category }}{{ .CommonLabels.category }}{{ else }}system{{ end }})'
            message: |-
              {{ range .Alerts }}
              Summary: {{ .Annotations.summary }}
              Hint: {{ .Annotations.hint }}
              ---
              {{ end }}

# ------------------------------------------------------------------------------
# Grafana Configuration (Default Home Dashboard & Provisioning)
# ------------------------------------------------------------------------------
grafana:
  # Sets the default home dashboard displayed upon opening the Grafana UI
  grafana.ini:
    dashboards:
      default_home_dashboard_path: /tmp/dashboards/kube_prober_dashboard.json

  # Enables sidecar auto-discovery for Grafana dashboards defined via ConfigMaps
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: ALL

# Disable control plane components for k3s/k3d compatibility
#kubeControllerManager:
#  enabled: false

#kubeScheduler:
#  enabled: false

#kubeProxy:
#  enabled: false

#nodeExporter:
#  enabled: false
